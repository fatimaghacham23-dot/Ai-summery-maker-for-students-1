# Server
PORT=3000
NODE_ENV=development
# SQLite file path (tests default to :memory: when NODE_ENV=test)
DATABASE_PATH=data/app.db

# Debug (optional)
DEBUG_TOKEN="CHANGE_ME"
ENABLE_DEBUG_ROUTES=false

# Image generation
IMAGE_PROVIDER=
USE_MOCK_IMAGE_PROVIDER=false
# Set USE_MOCK_IMAGE_PROVIDER=true to mock while real providers are absent.
IMAGE_DEBUG=true
IMAGE_MODEL=gpt-image-1

# OpenAI provider (used when IMAGE_PROVIDER=openai)
OPENAI_API_KEY="sk_your_key_here"

# Song generator
SONG_PROVIDER=mock
# Optional OpenAI song model when SONG_PROVIDER=openai
OPENAI_MODEL_SONG=gpt-4o-mini

# Grammar fixer
GRAMMAR_PROVIDER=mock
# Optional OpenAI grammar model when GRAMMAR_PROVIDER=openai
OPENAI_MODEL_GRAMMAR=gpt-4o-mini

# Hugging Face router provider (used when IMAGE_PROVIDER=huggingface)
HF_TOKEN="hf_your_token_here"
# (optional) legacy Hugging Face key alias
HUGGINGFACE_API_KEY="hf_your_token_here"
HF_ROUTER_BASE_URL="https://router.huggingface.co"
HF_ROUTER_PROVIDER="your-provider"
HF_IMAGE_MODEL="your-model"

# Optional: validate the Hugging Face router model on server start
VALIDATE_IMAGE_SERVICE_ON_START=false
